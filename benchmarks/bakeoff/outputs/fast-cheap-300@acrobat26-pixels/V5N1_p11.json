     ],
     "text": "Comparative growing trial"
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Comparative growing trial",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
    42.72,
    192.72,
