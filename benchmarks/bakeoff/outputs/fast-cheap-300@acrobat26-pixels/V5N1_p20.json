     "bbox": [
      50.16,
      86.88,
      285.84,
      96.96
     ],
     "text": "growing trial conducted at the Agricultural Research Centre,"
    },
    {
     "bbox": [
      50.16,
      97.92,
      286.08,
      107.28
     ],
     "text": "Tamworth in 1990 and 1991. Transplanted seedlings were"
    },
    {
     "bbox": [
      50.64,
      108.24,
      284.64,
      119.28
     ],
     "text": "sown in the field on 16 July 1990. Plants were sown on a |"
