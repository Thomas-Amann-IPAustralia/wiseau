   "lines": [
    {
     "bbox": [
      327.12,
      73.44,
      562.32,
      82.8
     ],
     "text": "The breeder was Markus Schmulling of Schmulling Nurseries"
    },
    {
     "bbox": [
      327.84,
      84.72,
      563.04,
      94.8
     ],
     "text": "in Billerbeck, Germany. \u2018Ulyssis\u2019 was selected as a sport of"
    },
    {
     "bbox": [
      328.32,
      96.0,
      562.32,
      105.6
     ],
     "text": "\u2018Schone von Nizza\u2019 and propagated vegetatively for several"
    },
    {
     "bbox": [
      327.6,
      108.24,
      450.24,
      117.36
     ],
     "text": "generations to establish stability."
    }
   ],
