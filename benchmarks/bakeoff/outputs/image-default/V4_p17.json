    {
     "bbox": [
      53.04,
      652.32,
      282.24,
      660.48
     ],
     "text": "Ail characteristics described below are from comparative"
    },
    {
     "bbox": [
      53.28,
      662.16,
      286.8,
      670.32
     ],
     "text": "growing trials conducted at Muchea in Western Australia."
    },
    {
     "bbox": [
      54.0,
      672.0,
      289.68,
      680.4
     ],
     "text": "Plants were propagated from cuttings planted out in mid\u2014"
    },
    {
     "bbox": [
      54.0,
      681.36,
      282.24,
      689.76
     ],
     "text": "1988 at 1 metre intervals in rows 1 metre apart in sandy"
    },
    {
     "bbox": [
      53.52,
      691.44,
      251.52,
      699.84
     ],
     "text": "soil. Water and fertilizer were applied with trickle"
    },
    {
     "bbox": [
      53.76,
      701.28,
      282.72,
      709.68
     ],
     "text": "irrigation, Insecticides and herbicides were applied when"
    },
    {
     "bbox": [
      53.28,
      711.12,
      263.28,
      719.52
     ],
     "text": "considered necessary. Plants were pruned annually."
    },
    {
     "bbox": [
      53.52,
      721.2,
      285.36,
      729.6
     ],
     "text": "Measurements were made from between five and twenty"
    },
    {
     "bbox": [
      53.28,
      731.04,
      269.52,
      739.92
     ],
     "text": "samples taken at random. Sampling took place during"
    },
    {
     "bbox": [
      53.04,
      741.36,
      266.88,
      750.0
     ],
     "text": "flowering in September for \u2018Elegance\u2019 and \u2018Mullering"
    },
    {
     "bbox": [
      53.52,
      751.2,
      275.04,
      759.84
     ],
     "text": "Brook\u2019, and during flowering in November for \u2018Pristine\u2019,"
    },
    {
     "bbox": [
      53.76,
      761.28,
      249.12,
      769.44
     ],
     "text": "\u2018Triumphant\u2019, \u2018Pear! Buttons\u2019 and \u2018White Spring\u2019."
    }
   ],
