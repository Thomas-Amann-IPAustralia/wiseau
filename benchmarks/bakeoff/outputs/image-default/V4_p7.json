   "lines": [
    {
     "bbox": [
      48.0,
      185.28,
      253.44,
      194.64
     ],
     "text": "This variety arose from the controlled pollination of"
    },
    {
     "bbox": [
      48.96,
      195.12,
      274.56,
      204.96
     ],
     "text": "\u2018Stargazer\u2019 with pollen from an unnamed male parent. It"
    },
    {
     "bbox": [
      48.48,
      205.44,
      274.56,
      215.04
     ],
     "text": "was bred by Gebr. Vletter en J A den Haan of Rijnsburg,"
    },
    {
     "bbox": [
      48.72,
      215.52,
      241.68,
      223.68
     ],
     "text": "Netherlands in 1982. \u2018Venezia\u2019 was selected for"
    },
    {
     "bbox": [
      48.48,
      225.6,
      270.72,
      234.96
     ],
     "text": "development on the basis of flower size, colour and the"
    },
    {
     "bbox": [
      48.72,
      235.44,
      270.72,
      243.36
     ],
     "text": "erect manner in which the flowers are borne. \u2018Venezia\u2019"
    },
    {
     "bbox": [
      48.24,
      245.76,
      253.92,
      254.64
     ],
     "text": "was then propagated asexually. \u2018Venezia\u2019 has been"
    },
    {
     "bbox": [
      48.96,
      255.36,
      281.28,
      264.48
     ],
     "text": "protected by Plant Variety Rights in the Netherlands since"
    },
    {
     "bbox": [
      49.68,
      265.2,
      233.28,
      272.64
     ],
     "text": "1988 and sold in the Netherlands since 1988."
    }
   ],
   "page": 1,
   "score": 0.9469,
   "signal": "pp-doclayoutv3",
   "source": "tesseract-psm3",
   "text": "This variety arose from the controlled pollination of\n\u2018Stargazer\u2019 with pollen from an unnamed male parent. It\nwas bred by Gebr. Vletter en J A den Haan of Rijnsburg,\nNetherlands in 1982. \u2018Venezia\u2019 was selected for\ndevelopment on the basis of flower size, colour and the\nerect manner in which the flowers are borne. \u2018Venezia\u2019\nwas then propagated asexually. \u2018Venezia\u2019 has been\nprotected by Plant Variety Rights in the Netherlands since\n1988 and sold in the Netherlands since 1988.",
   "text_format": "plain",
   "type": "text"
  },
