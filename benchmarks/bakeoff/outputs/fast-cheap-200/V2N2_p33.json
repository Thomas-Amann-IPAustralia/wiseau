   "lines": [
    {
     "bbox": [
      296.64,
      201.24,
      508.68,
      209.88
     ],
     "text": "Variation: Add to the description... \u2018Young at Heart\u2019"
    },
    {
     "bbox": [
      297.0,
      211.32,
      475.2,
      219.96
     ],
     "text": "under high temperatures and low humidity"
    },
    {
     "bbox": [
      296.64,
      221.04,
      468.36,
      229.32
     ],
     "text": "conditions will show a much deeper petal"
    },
    {
     "bbox": [
      296.64,
      230.76,
      502.92,
      239.04
     ],
     "text": "colour(RHS29B). Petal counts will also be reduced"
    },
    {
     "bbox": [
      297.0,
      240.48,
      498.6,
      248.4
     ],
     "text": "(around 28 to 48 with a mean of 36). Leaf size will"
    },
    {
     "bbox": [
      297.36,
      250.92,
      504.0,
      258.12
     ],
     "text": "be smaller under these extreme conditions. These"
    },
    {
     "bbox": [
      296.64,
      260.64,
      489.6,
      269.64
     ],
     "text": "variations in the rose were observed during an"
    },
    {
     "bbox": [
      297.0,
      271.08,
      455.76,
      279.72
     ],
     "text": "extremely hot period in October, 1988."
    }
   ],
