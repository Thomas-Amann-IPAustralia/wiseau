   "id": "e11",
   "lines": [
    {
     "bbox": [
      321.12,
      549.72,
      439.56,
      558.72
     ],
     "text": "Comparative Growing Trials"
    },
    {
     "bbox": [
      320.76,
      559.8,
      549.72,
      568.8
     ],
     "text": "All characteristics described below are from comparative"
    },
    {
     "bbox": [
      321.12,
      569.88,
      547.92,
      578.52
     ],
     "text": "growing trials conducted at the Potato Research Station,"
    },
    {
     "bbox": [
      320.4,
      578.16,
      529.2,
      590.4
     ],
     "text": "Toolangi in Victoria in 1989/90 and 1990/91. Two"
    },
    {
     "bbox": [
      321.12,
      590.04,
      520.56,
      598.68
     ],
     "text": "hundred plants were grown in three replicates on"
    },
    {
     "bbox": [
      320.76,
      599.76,
      516.96,
      607.32
     ],
     "text": "kraznozem soil fertilised with Pivot 800 at 2t/ha."
    },
    {
     "bbox": [
      321.12,
      609.48,
      523.44,
      618.12
     ],
     "text": "Measurements are from 20 specimens selected at"
    },
    {
     "bbox": [
      321.12,
      619.92,
      557.28,
      628.56
     ],
     "text": "random. Plants were irrigated as required and prophylactic"
    },
    {
     "bbox": [
      320.76,
      629.64,
      533.16,
      638.64
     ],
     "text": "sprays were applied four times for fungal diseases of"
    },
    {
     "bbox": [
      320.76,
      639.36,
      348.84,
      647.64
     ],
     "text": "foliage."
