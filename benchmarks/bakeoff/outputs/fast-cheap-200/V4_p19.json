    {
     "bbox": [
      55.08,
      652.68,
      96.12,
      660.96
     ],
     "text": "Diagnosis"
    },
    {
     "bbox": [
      55.08,
      662.04,
      277.92,
      671.04
     ],
     "text": "\u2018Wilwash\u2019 is a smooth-skinned round potato with white"
    },
    {
     "bbox": [
      54.72,
      672.12,
      288.0,
      679.68
     ],
     "text": "flesh and white skin. It has few flowers with white corolla"
    },
    {
     "bbox": [
      54.72,
      681.84,
      277.92,
      690.12
     ],
     "text": "and the lightsprout base anthocyanin is blue-violet. It is"
    },
    {
     "bbox": [
      54.36,
      691.56,
      266.4,
      700.2
     ],
     "text": "distinct from known varieties in having the following"
    },
    {
     "bbox": [
      54.36,
      701.28,
      276.84,
      708.48
     ],
     "text": "combination of characters: leaflets absent or few in the"
    },
    {
     "bbox": [
      54.36,
      711.0,
      279.72,
      719.64
     ],
     "text": "axils of the inflorescence, short flowering period, eartier"
    },
    {
     "bbox": [
      54.72,
      721.08,
      112.32,
      729.0
     ],
     "text": "plant maturity."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Diagnosis\n\u2018Wilwash\u2019 is a smooth-skinned round potato with white\nflesh and white skin. It has few flowers with white corolla\nand the lightsprout base anthocyanin is blue-violet. It is\ndistinct from known varieties in having the following\ncombination of characters: leaflets absent or few in the\naxils of the inflorescence, short flowering period, eartier\nplant maturity.",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
    54.36,
    744.48,
    269.28,
    772.92
   ],
   "id": "e10",
   "lines": [
    {
     "bbox": [
      54.36,
      744.48,
      179.28,
      753.48
     ],
     "text": "Varieties used for comparison"
    },
    {
     "bbox": [
      54.36,
      754.56,
      269.28,
      763.56
     ],
     "text": "\"Coliban\u2019 being the closest known variety, an industry"
    },
    {
     "bbox": [
      54.72,
      765.0,
      246.6,
      772.92
     ],
     "text": "standard variety and one of the parent varieties."
    }
   ],
