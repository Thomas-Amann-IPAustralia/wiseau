   "page": 1,
   "source": "tesseract-psm3",
   "text": "Diagnosis\nThis variety is distinct from all other known\nvarieties in having the following combination of\ncharacters: a prostrate trailing growth habit\n(attaining little more than 20 cm height) with stems\nbecoming slightly tortuous in age.",
   "text_format": "plain",
   "type": "text"
