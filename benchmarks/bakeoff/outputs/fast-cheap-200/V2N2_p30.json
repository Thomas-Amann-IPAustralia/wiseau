    {
     "bbox": [
      87.12,
      732.24,
      288.72,
      741.24
     ],
     "text": "from cuttings. It is considered by the applicant to"
    },
    {
     "bbox": [
      87.84,
      742.32,
      273.6,
      750.96
     ],
     "text": "be suitable for growth outdoors in temperate"
