      297.36,
      223.68,
      341.76,
      232.56
     ],
     "text": "Agronomy"
    },
    {
     "bbox": [
      297.6,
      233.76,
      486.0,
      242.64
     ],
     "text": "\u2018Natsukaze\u2019 is intended as a summer growing"
    },
    {
     "bbox": [
      297.6,
      243.84,
      502.56,
      252.48
     ],
     "text": "perennial (3-4 years) pasture grass. It is known to"
    },
    {
     "bbox": [
      297.6,
      253.68,
      406.32,
      260.88
     ],
     "text": "have a low frost tolerance."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Agronomy\n\u2018Natsukaze\u2019 is intended as a summer growing\nperennial (3-4 years) pasture grass. It is known to\nhave a low frost tolerance.",
   "text_format": "plain",
   "type": "text"
