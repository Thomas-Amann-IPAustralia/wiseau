   "id": "e2",
   "lines": [
    {
     "bbox": [
      51.36,
      452.64,
      92.16,
      460.8
     ],
     "text": "Diagnosis"
    },
    {
     "bbox": [
      51.6,
      461.76,
      268.8,
      469.44
     ],
     "text": "\u2018Moonbeam\u2019 is a white flowered Galtonia. It is distinct"
    },
    {
     "bbox": [
      51.12,
      471.6,
      283.2,
      480.24
     ],
     "text": "from known varieties in having the following combination"
    },
    {
     "bbox": [
      51.36,
      481.68,
      282.72,
      490.08
     ],
     "text": "of characters: very full flowers, similar in appearance to a"
    },
    {
     "bbox": [
      50.88,
      491.28,
      277.68,
      499.92
     ],
     "text": "double tuberose (Polianthes sp.), opening flat with about"
    },
    {
     "bbox": [
      51.36,
      501.12,
      272.88,
      510.0
     ],
     "text": "forty flowers held erect on a scape of some 1.6 metres."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Diagnosis\n\u2018Moonbeam\u2019 is a white flowered Galtonia. It is distinct\nfrom known varieties in having the following combination\nof characters: very full flowers, similar in appearance to a\ndouble tuberose (Polianthes sp.), opening flat with about\nforty flowers held erect on a scape of some 1.6 metres.",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
    51.12,
    525.12,
    283.68,
    553.92
   ],
   "id": "e3",
   "lines": [
    {
     "bbox": [
      51.12,
      525.12,
      179.76,
      533.76
     ],
     "text": "Varieties Used for Comparison"
    },
    {
     "bbox": [
      51.6,
      535.2,
      283.68,
      543.36
     ],
     "text": "Galtonia candicans normal form, being the closest known"
    },
    {
     "bbox": [
      51.36,
      545.04,
      271.2,
      553.92
     ],
     "text": "variety and the only other varietal form known to exist."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Varieties Used for Comparison\nGaltonia candicans normal form, being the closest known\nvariety and the only other varietal form known to exist.",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
