    {
     "bbox": [
      304.56,
      377.28,
      537.6,
      385.68
     ],
     "text": "known variety. Six plants of Sesia\u2019 and twelve of \u2018Melissa\u2019"
    },
    {
     "bbox": [
      304.56,
      388.8,
      354.24,
      395.04
     ],
     "text": "were grown."
