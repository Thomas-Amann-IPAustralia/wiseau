   "lines": [
    {
     "bbox": [
      45.36,
      374.4,
      163.68,
      383.04
     ],
     "text": "Comparative Growing Trials"
    },
    {
     "bbox": [
      45.12,
      384.0,
      265.92,
      391.68
     ],
     "text": "All characteristics described for \u2018Autumn Biue\u2019 and the"
    },
    {
     "bbox": [
      45.36,
      393.6,
      266.64,
      402.48
     ],
     "text": "blue form of \u00a3. biloba are from 20 potted plants of each"
    },
    {
     "bbox": [
      45.12,
      404.16,
      280.08,
      413.28
     ],
     "text": "variety grown at Wanneroo, Western Australia. The plants"
    },
    {
     "bbox": [
      45.12,
      413.76,
      258.96,
      422.88
     ],
     "text": "were grown in 140 mm plastic pots in a mix of jarrah"
    },
    {
     "bbox": [
      45.36,
      423.6,
      260.64,
      432.72
     ],
     "text": "sawdust, medium grade pine bark, and washed white"
    },
    {
     "bbox": [
      45.6,
      433.68,
      267.6,
      441.36
     ],
     "text": "sand. The characteristics of \u2018White Flash\u2019 are described"
    },
    {
     "bbox": [
      45.6,
      443.52,
      268.56,
      452.64
     ],
     "text": "from specimens growing in the same soil mix in similar"
    },
    {
     "bbox": [
      45.6,
      453.12,
      282.24,
      462.24
     ],
     "text": "conditions at Kings Park, Perth. Measurements were taken"
    },
    {
     "bbox": [
      46.08,
      463.2,
      267.36,
      471.84
     ],
     "text": "in August 1990 from 20 specimens of each variety, the"
    },
    {
     "bbox": [
      45.6,
      473.52,
      164.16,
      482.16
     ],
     "text": "plants being aged 12 months."
    },
    {
     "bbox": [
      45.84,
      489.36,
      70.8,
      498.24
     ],
     "text": "Origin"
    },
    {
     "bbox": [
      44.88,
      498.48,
      265.92,
      508.08
     ],
     "text": "The variety arose as a chance seedling of Lechenaultia"
    },
    {
     "bbox": [
      45.12,
      509.28,
      261.6,
      517.68
     ],
     "text": "biloba found on the applicant\u2019s property at Wanneroo,"
    },
    {
     "bbox": [
      45.6,
      519.12,
      272.4,
      527.76
     ],
     "text": "Western Australia. Selection was on the basis of growth"
    },
    {
     "bbox": [
      46.32,
      529.44,
      256.08,
      538.08
     ],
     "text": "habit and duration of flowering. Subsequent asexual"
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Comparative Growing Trials\nAll characteristics described for \u2018Autumn Biue\u2019 and the\nblue form of \u00a3. biloba are from 20 potted plants of each\nvariety grown at Wanneroo, Western Australia. The plants\nwere grown in 140 mm plastic pots in a mix of jarrah\nsawdust, medium grade pine bark, and washed white\nsand. The characteristics of \u2018White Flash\u2019 are described\nfrom specimens growing in the same soil mix in similar\nconditions at Kings Park, Perth. Measurements were taken\nin August 1990 from 20 specimens of each variety, the\nplants being aged 12 months.\nOrigin\nThe variety arose as a chance seedling of Lechenaultia\nbiloba found on the applicant\u2019s property at Wanneroo,\nWestern Australia. Selection was on the basis of growth\nhabit and duration of flowering. Subsequent asexual",
   "text_format": "plain",
   "type": "text"
  },
