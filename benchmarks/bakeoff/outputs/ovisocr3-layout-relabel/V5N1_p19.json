   "lines": [
    {
     "bbox": [
      304.08,
      576.72,
      539.52,
      585.36
     ],
     "text": "it has a wider and longer inflorescence, a longer interbranch"
    },
    {
     "bbox": [
      304.08,
      587.52,
      539.52,
      594.48
     ],
     "text": "distance between the first and second branches of the inflores-"
    },
    {
     "bbox": [
      304.08,
      598.32,
      539.76,
      606.72
     ],
     "text": "cence. ‘Taranna’ also has a longer culm and longer flag and"
    },
    {
     "bbox": [
      304.08,
      609.12,
      492.96,
      617.52
     ],
     "text": "tiller leaves than the naturally occurring ecotypes."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "it has a wider and longer inflorescence, a longer interbranch\ndistance between the first and second branches of the inflores-\ncence. ‘Taranna’ also has a longer culm and longer flag and\ntiller leaves than the naturally occurring ecotypes.",
   "text_format": "plain",
   "type": "text",
