   ],
   "id": "e24",
   "lines": [
    {
     "bbox": [
      320.16,
      173.76,
      361.44,
      182.4
     ],
     "text": "Diagnosis"
    },
    {
     "bbox": [
      319.68,
      183.36,
      504.96,
      193.44
     ],
     "text": "This variety is distinct from any other known"
    },
    {
     "bbox": [
      319.68,
      193.44,
      508.8,
      203.52
     ],
     "text": "variety in having: a determinate plant growth"
    },
    {
     "bbox": [
      319.68,
      203.04,
      531.36,
      213.12
     ],
     "text": "habit; purple flowers, brown pubescence; a purple"
    },
    {
     "bbox": [
      319.68,
      213.12,
      533.28,
      223.2
     ],
     "text": "hypocoty!; tan pods; a spherical seed with a yellow"
    },
    {
     "bbox": [
      319.2,
      223.2,
      530.4,
      233.28
     ],
     "text": "coat, shiny lustre and a black hilum; and immunity"
    },
    {
     "bbox": [
      319.2,
      233.28,
      460.32,
      241.92
     ],
     "text": "to race 1 of Phytophthora root rot."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Diagnosis\nThis variety is distinct from any other known\nvariety in having: a determinate plant growth\nhabit; purple flowers, brown pubescence; a purple\nhypocoty!; tan pods; a spherical seed with a yellow\ncoat, shiny lustre and a black hilum; and immunity\nto race 1 of Phytophthora root rot.",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
    318.24,
    275.04,
    526.56,
    303.84
   ],
   "id": "e25",
   "lines": [
    {
     "bbox": [
      319.2,
      275.04,
      526.56,
      283.68
     ],
     "text": "\u2018Triton\u2019, Nautilus\u2019, \u2018Bossier\u2019, \u2018 \u2018Canapolis\u2019,"
    },
    {
     "bbox": [
      319.2,
      285.12,
      496.8,
      293.76
     ],
     "text": "\u2018Davis\u2019, \u2018Centaur\u2019 and \u2018Dragon\u2019 being other"
    },
    {
     "bbox": [
      318.24,
      295.2,
      462.72,
      303.84
     ],
     "text": "varieties with determinate growth."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "\u2018Triton\u2019, Nautilus\u2019, \u2018Bossier\u2019, \u2018 \u2018Canapolis\u2019,\n\u2018Davis\u2019, \u2018Centaur\u2019 and \u2018Dragon\u2019 being other\nvarieties with determinate growth.",
   "text_format": "plain",
   "type": "text"
  },
  {
   "bbox": [
    318.72,
    316.32,
    533.76,
    394.56
   ],
   "id": "e26",
   "lines": [
    {
     "bbox": [
      318.72,
      316.32,
      438.72,
      325.44
     ],
     "text": "Comparative Growing Trials"
    },
    {
     "bbox": [
      318.72,
      326.4,
      512.64,
      335.04
     ],
     "text": "All characteristics and comparisons are from a"
    },
    {
     "bbox": [
      318.72,
      336.0,
      517.92,
      345.12
     ],
     "text": "comparative growing trial planted at Hermitage"
    },
    {
     "bbox": [
      319.2,
      346.08,
      494.88,
      353.76
     ],
     "text": "Research Station, southern Queensland in"
    },
    {
     "bbox": [
      319.2,
      355.68,
      533.76,
      363.84
     ],
     "text": "December, 1989. Plots consisted of 5 metre rows 70"
    },
    {
     "bbox": [
      318.72,
      365.76,
      527.52,
      374.4
     ],
     "text": "cm apart, planted at a density of 20 per metre with"
    },
    {
     "bbox": [
      319.2,
      373.92,
      533.76,
      386.88
     ],
     "text": "2 replicates per variety. Measurements in tables are"
    },
    {
     "bbox": [
      318.72,
      385.92,
      446.88,
      394.56
     ],
     "text": "of 20 plants chosen at random."
    }
   ],
