   "lines": [
    {
     "bbox": [
      45.12,
      374.4,
      163.68,
      383.04
     ],
     "text": "Comparative Growing Trials"
    },
    {
     "bbox": [
      45.12,
      384.0,
      265.92,
      391.68
     ],
     "text": "All characteristics described for \u2018Autumn Blue\u2019 and the"
    },
    {
     "bbox": [
      45.12,
      393.6,
      266.88,
      402.24
     ],
     "text": "blue form of L. biloba are from 20 potted plants of each"
    },
    {
     "bbox": [
      45.12,
      404.16,
      280.32,
      413.28
     ],
     "text": "variety grown at Wanneroo, Western Australia. The plants"
    },
    {
     "bbox": [
      45.12,
      413.76,
      259.2,
      422.88
     ],
     "text": "were grown in 140 mm plastic pots in a mix of jarrah"
    },
    {
     "bbox": [
      45.12,
      423.84,
      260.64,
      432.96
     ],
     "text": "sawdust, medium grade pine bark, and washed white"
    },
    {
     "bbox": [
      45.6,
      433.92,
      267.84,
      441.12
     ],
     "text": "sand. The characteristics of \u2018White Flash\u2019 are described"
    },
    {
     "bbox": [
      45.6,
      443.52,
      268.8,
      452.64
     ],
     "text": "from specimens growing in the same soil mix in similar"
    },
    {
     "bbox": [
      45.6,
      453.12,
      282.24,
      462.24
     ],
     "text": "conditions at Kings Park, Perth. Measurements were taken"
    },
    {
     "bbox": [
      46.08,
      463.2,
      267.36,
      471.84
     ],
     "text": "in August 1990 from 20 specimens of each variety, the"
    },
    {
     "bbox": [
      45.6,
      473.28,
      162.24,
      481.92
     ],
     "text": "plants being aged 12 months."
    },
    {
     "bbox": [
      46.08,
      489.6,
      71.04,
      498.24
     ],
     "text": "Origin"
    },
    {
     "bbox": [
      45.12,
      498.72,
      265.92,
      507.84
     ],
     "text": "The variety arose as a chance seedling of Lechenaultia"
    },
    {
     "bbox": [
      45.12,
      509.28,
      261.6,
      517.92
     ],
     "text": "biloba found on the applicant\u2019s property at Wanneroo,"
    },
    {
     "bbox": [
      45.6,
      518.88,
      272.64,
      528.0
     ],
     "text": "Western Australia. Selection was on the basis of growth"
    },
    {
     "bbox": [
      46.08,
      529.44,
      256.32,
      538.08
     ],
     "text": "habit and duration of flowering. Subsequent asexual"
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Comparative Growing Trials\nAll characteristics described for \u2018Autumn Blue\u2019 and the\nblue form of L. biloba are from 20 potted plants of each\nvariety grown at Wanneroo, Western Australia. The plants\nwere grown in 140 mm plastic pots in a mix of jarrah\nsawdust, medium grade pine bark, and washed white\nsand. The characteristics of \u2018White Flash\u2019 are described\nfrom specimens growing in the same soil mix in similar\nconditions at Kings Park, Perth. Measurements were taken\nin August 1990 from 20 specimens of each variety, the\nplants being aged 12 months.\nOrigin\nThe variety arose as a chance seedling of Lechenaultia\nbiloba found on the applicant\u2019s property at Wanneroo,\nWestern Australia. Selection was on the basis of growth\nhabit and duration of flowering. Subsequent asexual",
   "text_format": "plain",
   "type": "text"
  },
