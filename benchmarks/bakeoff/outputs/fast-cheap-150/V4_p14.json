     "bbox": [
      43.68,
      173.28,
      246.24,
      182.88
     ],
     "text": "\"Sunkissed Waters\u2019 is suited to sub-tropical to cool"
    },
    {
     "bbox": [
      43.2,
      183.84,
      120.0,
      192.0
     ],
     "text": "temperate climates."
    }
   ],
   "page": 1,
