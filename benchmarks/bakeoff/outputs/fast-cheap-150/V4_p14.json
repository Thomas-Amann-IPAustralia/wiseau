     "bbox": [
      41.28,
      649.92,
      82.08,
      658.08
     ],
     "text": "Diagnosis"
    },
    {
     "bbox": [
      41.28,
      660.0,
      261.6,
      667.2
     ],
     "text": "\u201cRemember Me\u2019 (Cocdestin) is a russet shrub rose. It is"
    },
    {
     "bbox": [
      40.8,
      669.6,
      276.48,
      678.24
     ],
     "text": "distinct from other known varieties in having the following"
    },
    {
     "bbox": [
      40.8,
      679.68,
      262.08,
      687.84
     ],
     "text": "combination of characters: pointed buds; large flowers;"
    },
    {
     "bbox": [
      41.28,
      689.76,
      265.44,
      697.44
     ],
     "text": "very strong sepal extensions; small pitcher shaped seed"
    },
    {
     "bbox": [
      40.8,
      699.36,
      258.24,
      707.52
     ],
     "text": "vessel; yellow stamen filaments and strong fragrance;"
    },
    {
     "bbox": [
      41.28,
      708.96,
      263.04,
      717.12
     ],
     "text": "narrow terminal leaflet in ratio to its length and a short"
    },
    {
     "bbox": [
      41.28,
      718.56,
      140.64,
      726.72
     ],
     "text": "terminal leaflet petiolule."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Diagnosis\n\u201cRemember Me\u2019 (Cocdestin) is a russet shrub rose. It is\ndistinct from other known varieties in having the following\ncombination of characters: pointed buds; large flowers;\nvery strong sepal extensions; small pitcher shaped seed\nvessel; yellow stamen filaments and strong fragrance;\nnarrow terminal leaflet in ratio to its length and a short\nterminal leaflet petiolule.",
   "text_format": "plain",
   "type": "text"
  },
