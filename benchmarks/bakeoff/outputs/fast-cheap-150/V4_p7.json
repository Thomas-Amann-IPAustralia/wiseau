   "lines": [
    {
     "bbox": [
      313.92,
      60.0,
      468.96,
      69.6
     ],
     "text": "Morphology \u2014 see comparison tables."
    },
    {
     "bbox": [
      314.4,
      70.08,
      526.56,
      78.72
     ],
     "text": "\u2018Venezia\u2019 is a medium-sized lily with very large bowl-"
    },
    {
     "bbox": [
      313.92,
      79.68,
      537.6,
      89.76
     ],
     "text": "shaped flowers which stand more upright than those of"
    },
    {
     "bbox": [
      314.4,
      90.24,
      514.08,
      99.84
     ],
     "text": "\u201cStargazer. \u2018Venezia\u2019 produces more flowers than"
    },
    {
     "bbox": [
      314.4,
      100.32,
      532.32,
      109.92
     ],
     "text": "\u2018Stargazer\u2019 from the same size bulb, up to 15 per stem"
    },
    {
     "bbox": [
      313.92,
      109.44,
      544.8,
      119.52
     ],
     "text": "whereas \u2018Stargazer\u2019 produces up to 6. \u2018Venezia\u2019 has deep"
    },
    {
     "bbox": [
      314.4,
      120.0,
      544.8,
      129.6
     ],
     "text": "pink flowers corresponding to RHS 63A-C whereas those"
    },
    {
     "bbox": [
      313.92,
      129.6,
      526.08,
      139.68
     ],
     "text": "of \u2018Stargazer\u2019 are greyed-pink, corresponding to RHS"
    },
    {
     "bbox": [
      315.36,
      139.68,
      540.0,
      148.32
     ],
     "text": "187A-B. \u2018Venezia\u2019 has less bud anthocyanin colouration"
    },
    {
     "bbox": [
      314.4,
      149.28,
      539.04,
      158.4
     ],
     "text": "and less stem anthocyanin colouration than \u2018Stargazer\u2019."
    },
    {
     "bbox": [
      314.88,
      159.84,
      516.96,
      168.96
     ],
     "text": "\u2018Venezia\u2019 has longer and lighter green leaves than"
    },
    {
     "bbox": [
      315.36,
      170.4,
      359.04,
      179.04
     ],
     "text": "\u2018Stargazer\u2019."
    }
   ],
   "page": 1,
   "source": "tesseract-psm3",
   "text": "Morphology \u2014 see comparison tables.\n\u2018Venezia\u2019 is a medium-sized lily with very large bowl-\nshaped flowers which stand more upright than those of\n\u201cStargazer. \u2018Venezia\u2019 produces more flowers than\n\u2018Stargazer\u2019 from the same size bulb, up to 15 per stem\nwhereas \u2018Stargazer\u2019 produces up to 6. \u2018Venezia\u2019 has deep\npink flowers corresponding to RHS 63A-C whereas those\nof \u2018Stargazer\u2019 are greyed-pink, corresponding to RHS\n187A-B. \u2018Venezia\u2019 has less bud anthocyanin colouration\nand less stem anthocyanin colouration than \u2018Stargazer\u2019.\n\u2018Venezia\u2019 has longer and lighter green leaves than\n\u2018Stargazer\u2019.",
   "text_format": "plain",
   "type": "text"
  },
