     ],
     "text": "Diagnosis"
    },
    {
     "bbox": [
      315.36,
      542.4,
      528.0,
      551.04
     ],
     "text": "\u2018Redlands Trailblazer\u2019 is an open-pollinated vine-type"
    },
    {
     "bbox": [
      314.88,
      552.0,
      534.24,
      560.16
     ],
     "text": "pumpkin. It is distinct from all other known varieties in"
    },
    {
     "bbox": [
      315.36,
      562.08,
      550.56,
      570.24
     ],
     "text": "having the following combination of characters: resistance"
    },
    {
     "bbox": [
      315.36,
      571.68,
      527.04,
      580.32
     ],
     "text": "to zucchini yellow mosaic virus; resistance to papaya"
    },
    {
     "bbox": [
      314.88,
      581.76,
      539.04,
      589.92
     ],
     "text": "ringspot virus type W; resistance to watermelon mosaic"
    },
    {
     "bbox": [
      314.88,
      591.36,
      521.76,
      600.0
     ],
     "text": "virus type 2; a white seed coat; and lobed leaves on"
    },
    {
     "bbox": [
      315.36,
      601.44,
      370.56,
      609.12
     ],
     "text": "mature plants."
    }
